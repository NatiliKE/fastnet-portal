# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Admin initial passcode (optional; if unset, first-run setup UI claims the initial admin account)
ADMIN_DEFAULT_PASSWORD=

# Safaricom Daraja M-Pesa API Credentials (optional for sandbox preview; required for live STK Push)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Default MikroTik RouterOS API Credentials (optional; routers can also be configured in Admin Settings)
MIKROTIK_DEFAULT_HOST=
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_DEFAULT_USER=
MIKROTIK_DEFAULT_PASSWORD=
